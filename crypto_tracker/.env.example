# Crypto Tracker Configuration Example
# Copy this file to .env and fill in your actual values

# ============================================
# Blockchain API Keys
# ============================================

# Etherscan API (for Ethereum blockchain data)
# Get free key at: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Moralis API (for multi-chain wallet tracking)
# Get key at: https://moralis.io/
MORALIS_API_KEY=

# Alchemy API (for fast RPC access)
# Get key at: https://alchemy.com/
ALCHEMY_API_KEY=

# ============================================
# Social Platform API Keys
# ============================================

# Twitter/X API v2 (for smart money tracking)
# Apply at: https://developer.twitter.com/
TWITTER_API_KEY=

# ============================================
# Alert Configuration
# ============================================

# Discord Webhook URL (for alerts)
# Create in Discord: Server Settings -> Integrations -> Webhooks
DISCORD_WEBHOOK_URL=

# Telegram Bot (for alerts)
# Create bot with @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================
# Tracking Configuration
# ============================================

# Chains to monitor (comma-separated)
# Options: eth, sol, base, arbitrum, polygon, bsc
TRACKED_CHAINS=eth,sol,base

# ============================================
# Whale Tracker Settings
# ============================================

# Minimum whale transaction value in USD
WHALE_MIN_TX_VALUE=10000.0

# Check interval in seconds (60 = 1 minute)
WHALE_CHECK_INTERVAL=60

# ============================================
# DEX Scraper Settings
# ============================================

# Minimum liquidity to consider (USD)
DEX_MIN_LIQUIDITY=10000.0

# Check interval in seconds (300 = 5 minutes)
DEX_CHECK_INTERVAL=300

# ============================================
# Sentiment Tracker Settings
# ============================================

# Minimum mentions to trigger signal
SENTIMENT_MIN_MENTIONS=10

# Check interval in seconds (600 = 10 minutes)
SENTIMENT_CHECK_INTERVAL=600

# ============================================
# Alert Manager Settings
# ============================================

# Minimum number of independent sources for alert
ALERT_MIN_SOURCES=3

# Time window for signal correlation (seconds)
# 3600 = 1 hour
ALERT_CONFIRMATION_WINDOW=3600

# ============================================
# Risk Management
# ============================================

# Maximum position size as % of portfolio
MAX_POSITION_SIZE_PCT=2.0

# Stop loss percentage
STOP_LOSS_PCT=30.0

# Daily loss limit as % of portfolio
DAILY_LOSS_LIMIT_PCT=5.0
